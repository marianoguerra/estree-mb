// Embeds every fixtures/json/*.json file into fixtures_test.mbt as a roundtrip
// test and, together with its fixtures/codegen/*.json astring record, into
// codegen/oracle_test.mbt. Reports ESTree node types no fixture covers.
//
// Run from the module root: moon run tools/embed_fixtures.mbtx

import {
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
}

///|
let fixtures_dir = "fixtures/json"

///|
let oracle_dir = "fixtures/codegen"

///|
let output_file = "fixtures_test.mbt"

///|
let oracle_output_file = "codegen/oracle_test.mbt"

///|
let generated_header = "// Generated by tools/embed_fixtures.mbtx. Do not edit.\n"

///|
/// Every node `type` in ES5–ES2026 and stage 3.
let all_node_types : Array[String] = [
  "AccessorProperty", "ArrayExpression", "ArrayPattern", "ArrowFunctionExpression",
  "AssignmentExpression", "AssignmentPattern", "AwaitExpression", "BinaryExpression",
  "BlockStatement", "BreakStatement", "CallExpression", "CatchClause", "ChainExpression",
  "ClassBody", "ClassDeclaration", "ClassExpression", "ConditionalExpression",
  "ContinueStatement", "DebuggerStatement", "Decorator", "DoWhileStatement",
  "EmptyStatement", "ExportAllDeclaration", "ExportDefaultDeclaration",
  "ExportNamedDeclaration", "ExportSpecifier", "ExpressionStatement", "ForInStatement",
  "ForOfStatement", "ForStatement", "FunctionDeclaration", "FunctionExpression",
  "Identifier", "IfStatement", "ImportAttribute", "ImportDeclaration",
  "ImportDefaultSpecifier", "ImportExpression", "ImportNamespaceSpecifier",
  "ImportSpecifier", "LabeledStatement", "Literal", "LogicalExpression",
  "MemberExpression", "MetaProperty", "MethodDefinition", "NewExpression",
  "ObjectExpression", "ObjectPattern", "PrivateIdentifier", "Program", "Property",
  "PropertyDefinition", "RestElement", "ReturnStatement", "SequenceExpression",
  "SpreadElement", "StaticBlock", "Super", "SwitchCase", "SwitchStatement",
  "TaggedTemplateExpression", "TemplateElement", "TemplateLiteral", "ThisExpression",
  "ThrowStatement", "TryStatement", "UnaryExpression", "UpdateExpression",
  "VariableDeclaration", "VariableDeclarator", "WhileStatement", "WithStatement",
  "YieldExpression",
]

///|
fn collect_types(json : Json, seen : Map[String, Unit]) -> Unit {
  match json {
    Object(fields) => {
      if fields.get("type") is Some(String(type_)) {
        seen[type_] = ()
      }
      for _, value in fields {
        collect_types(value, seen)
      }
    }
    Array(items) => for item in items { collect_types(item, seen) }
    _ => ()
  }
}

///|
/// Writes `json` as `#|` raw-string lines, breaking after commas outside
/// strings so no line exceeds the compiler's column limit.
fn write_raw_json(out : StringBuilder, json : Json) -> Unit {
  let text = json.stringify()
  out.write_string("    #|")
  let mut column = 0
  let mut in_string = false
  let mut escaped = false
  for c in text {
    out.write_char(c)
    column += 1
    if in_string {
      if escaped {
        escaped = false
      } else if c == '\\' {
        escaped = true
      } else if c == '"' {
        in_string = false
      }
    } else if c == '"' {
      in_string = true
    } else if c == ',' && column > 2000 {
      out.write_string("\n    #|")
      column = 0
    }
  }
  out.write_char('\n')
}

///|
fn main raise {
  let names = @fs.read_dir(fixtures_dir).to_owned().filter(name => name.has_suffix(".json"))
  names.sort()
  let seen : Map[String, Unit] = Map([])
  let out = StringBuilder()
  let oracle_out = StringBuilder()
  out.write_string(generated_header)
  oracle_out.write_string(generated_header)
  for name in names {
    let json = @json.parse(@fs.read_file_to_string("\{fixtures_dir}/\{name}"))
    collect_types(json, seen)
    let test_name = name.strip_suffix(".json").unwrap().to_owned()
    out <+ "\n///|\ntest \"roundtrip \{test_name}\" {\n  let source =\n"
    write_raw_json(out, json)
    out <+ "  assert_roundtrip(source)\n}\n"
    let oracle_path = "\{oracle_dir}/\{name}"
    if @fs.path_exists(oracle_path) {
      let oracle = @json.parse(@fs.read_file_to_string(oracle_path))
      oracle_out <+ "\n///|\ntest \"astring oracle \{test_name}\" {\n  let source =\n"
      write_raw_json(oracle_out, json)
      oracle_out <+ "  let oracle =\n"
      write_raw_json(oracle_out, oracle)
      oracle_out <+ "  check_oracle(source, oracle)\n}\n"
    }
  }
  @fs.write_string_to_file(output_file, out.to_string())
  @fs.write_string_to_file(oracle_output_file, oracle_out.to_string())
  println("embedded \{names.length()} fixtures into \{output_file} and \{oracle_output_file}")
  let missing = all_node_types.filter(t => !seen.contains(t))
  if missing.is_empty() {
    println("all \{all_node_types.length()} node types covered")
  } else {
    println("uncovered node types: \{missing.join(", ")}")
  }
}
